# Firecrawl Self-Hosted Environment Configuration for OpenAgent
PORT=3002
INTERNAL_PORT=3002
HOST=0.0.0.0

# Authentication: false enables zero-auth local API access (no Supabase account needed)
USE_DB_AUTHENTICATION=false

# Queue & Worker settings
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# Playwright engine options
BLOCK_MEDIA=true

# Optional: Local Ollama URL for offline structured data extraction
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: SearXNG for offline zero-cloud search
# SEARXNG_ENDPOINT=http://searxng:8080
