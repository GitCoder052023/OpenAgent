BRIDGE_WHATSAPP_NUMBER=+16508702892
# Speech-to-text: OpenAI Whisper Large V3 Turbo, running entirely on this Mac.
# Engine: 'auto' (mlx on Apple Silicon, whisper.cpp otherwise), 'mlx', or 'whisper.cpp'
BRIDGE_STT_ENGINE=auto
# mlx engine: Hugging Face repo holding the Large V3 Turbo weights (cached in ~/.cache/huggingface)
BRIDGE_WHISPER_REPO=mlx-community/whisper-large-v3-turbo
# whisper.cpp engine: ggml model file (bash scripts/download-model.sh large-v3-turbo)
BRIDGE_WHISPER_MODEL=models/ggml-large-v3-turbo.bin
BRIDGE_LANGUAGE=auto
# Wake phrases are English; pinning the language keeps short utterances from
# being auto-detected as another one.
BRIDGE_WAKE_LANGUAGE=en
BRIDGE_WHISPER_CLI=whisper-cli
BRIDGE_RECORDER=rec
# Safe mode: Set false to unlock system and enable dynamic chat detection
BRIDGE_SAFE_MODE=true
# Send mode: 'audio' (send M4A file attachment, default) or 'text' (local Whisper Large V3 Turbo -> WhatsApp message)
BRIDGE_SEND_MODE=audio
# Send route: 'picker' (default WhatsApp document sheet), 'clipboard' (Cmd+V paste), or 'auto' (try clipboard then picker)
BRIDGE_SEND_ROUTE=picker
# Hotkey: push-to-talk trigger (e.g. f8, f6, right_shift)
BRIDGE_HOTKEY=f8

# Calibration (optional when safe mode is false; required when safe mode is true)
BRIDGE_HEADER_PATH=
BRIDGE_MESSAGE_LIST_PATH=
BRIDGE_INCOMING_MARKER=

# Exact non-body AX button labels observed locally; leave empty to disable automatic playback.
BRIDGE_VOICE_PLAY_MARKER=
BRIDGE_VOICE_PAUSE_MARKER=
# Required when using file picker route (BRIDGE_SEND_ROUTE=picker); calibrate exact UI labels on your Mac.
BRIDGE_ATTACH_LABEL=
BRIDGE_DOCUMENT_LABEL=
BRIDGE_ATTACHMENT_SEND_LABEL=

# Continuous voice wake-phrase mode (opt-in via `OpenAgent run --voice`)
# Wake phrases and requests are both recognized by the local Whisper model above.
# Seconds of quiet that end an utterance and send it.
BRIDGE_VOICE_SILENCE_SECONDS=2.0

# Diagnostics & Safety Ledger paths
# BRIDGE_LOG_FILE=~/Library/Logs/OpenAgent/bridge.jsonl
# BRIDGE_LEDGER_FILE=~/Library/Logs/OpenAgent/processed.jsonl

# Browser Harness CDP Configuration (Chrome background control & domain skills)
BH_AGENT_WORKSPACE=src/tools/browser-harness/agent-workspace
BH_DOMAIN_SKILLS=1
BH_TAB_MARKER=1

# Firecrawl Self-Hosted Web Ingestion & Extraction Engine
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT=60.0

# LocoAgent Social Media Automation Engine (CDP Browser Profiles)
LOCOAGENT_ENABLED=true
LOCOAGENT_ROOT=
LOCOAGENT_DEFAULT_PLATFORM=threads
LOCOAGENT_TIMEOUT=120.0

# Immersive Terminal Sound Engine
# Enable or disable acoustic feedback for tool calls, responses, messages, logs, etc.
BRIDGE_SOUND_ENABLED=true
# Master volume level (0.0 to 1.0)
BRIDGE_SOUND_VOLUME=1.0

# ==============================================================================
# Brain Engine Architecture Selection
# ==============================================================================
# Options:
#  - 'instinct': Commercial cloud Instinct (WhatsApp Desktop bridge + voice) [Default]
#  - 'openinstinct': Local sovereign brain (Ollama + text REPL, 100% private, no WhatsApp)
OPENAGENT_BRAIN=instinct

# OpenInstinct Local Brain Settings
OPENINSTINCT_MODEL=qwen2.5-coder:7b
OPENINSTINCT_OLLAMA_URL=http://localhost:11434
OPENINSTINCT_TEMPERATURE=0.2

# ==============================================================================
# Native WhatsApp MCP Extended Protocol Engine (src/tools/whatsapp-mcp)
# ==============================================================================
# Headless WhatsApp multi-device client via Go whatsmeow & FastMCP
WHATSAPP_MCP_ENABLED=true
# REST bridge URL (default: http://localhost:8180 if using docker-compose, or http://localhost:8080 if native)
WHATSAPP_MCP_API_URL=http://localhost:8180
# Optional API Key if bridge authentication is enabled
WHATSAPP_MCP_API_KEY=
WHATSAPP_MCP_TIMEOUT=30.0
# Safety gate: Comma-separated list of allowed phone numbers or group JIDs (leave empty to allow all)
# WHATSAPP_ALLOWLIST_JIDS=1234567890,9876543210@s.whatsapp.net




