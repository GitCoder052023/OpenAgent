BRIDGE_WHATSAPP_NUMBER=+16508702892
BRIDGE_WHISPER_MODEL=models/ggml-base.bin
BRIDGE_LANGUAGE=auto
BRIDGE_WHISPER_CLI=whisper-cli
BRIDGE_RECORDER=rec
# Safe mode: Set false to unlock system and enable dynamic chat detection
BRIDGE_SAFE_MODE=true
# Send mode: 'audio' (send M4A file attachment, default) or 'text' (Whisper STT -> WhatsApp message)
BRIDGE_SEND_MODE=audio
# Send route: 'picker' (default WhatsApp document sheet), 'clipboard' (Cmd+V paste), or 'auto' (try clipboard then picker)
BRIDGE_SEND_ROUTE=picker
# Hotkey: push-to-talk trigger (e.g. f8, f6, right_shift)
BRIDGE_HOTKEY=f8

# Calibration (optional when safe mode is false; required when safe mode is true)
BRIDGE_HEADER_PATH=
BRIDGE_MESSAGE_LIST_PATH=
BRIDGE_INCOMING_MARKER=

# Exact non-body AX button labels observed locally; leave empty to disable automatic playback.
BRIDGE_VOICE_PLAY_MARKER=
BRIDGE_VOICE_PAUSE_MARKER=
# Required when using file picker route (BRIDGE_SEND_ROUTE=picker); calibrate exact UI labels on your Mac.
BRIDGE_ATTACH_LABEL=
BRIDGE_DOCUMENT_LABEL=
BRIDGE_ATTACHMENT_SEND_LABEL=

# Continuous voice wake-phrase mode (opt-in via `OpenAgent run --voice --send-mode audio` or `--voice`)
# Download a Vosk English model and point this at its extracted directory.
BRIDGE_VOICE_MODEL=models/vosk-model-small-en-us-0.15
BRIDGE_VOICE_SILENCE_SECONDS=2.0

# Diagnostics & Safety Ledger paths
# BRIDGE_LOG_FILE=~/Library/Logs/OpenAgent/bridge.jsonl
# BRIDGE_LEDGER_FILE=~/Library/Logs/OpenAgent/processed.jsonl

# Browser Harness CDP Configuration (Chrome background control & domain skills)
BH_AGENT_WORKSPACE=src/tools/browser-harness/agent-workspace
BH_DOMAIN_SKILLS=1
BH_TAB_MARKER=1

# Firecrawl Self-Hosted Web Ingestion & Extraction Engine
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT=60.0

# LocoAgent Social Media Automation Engine (CDP Browser Profiles)
LOCOAGENT_ENABLED=true
LOCOAGENT_ROOT=
LOCOAGENT_DEFAULT_PLATFORM=threads
LOCOAGENT_TIMEOUT=120.0

# Immersive Terminal Sound Engine
# Enable or disable acoustic feedback for tool calls, responses, messages, logs, etc.
BRIDGE_SOUND_ENABLED=true
# Master volume level (0.0 to 1.0)
BRIDGE_SOUND_VOLUME=1.0


